<% for (let message of messages) { %>
    <ul>
        <li><span>Username: <%= message.user%> </span></li>
        <li><span>Message: <%= message.text%></span></li>
        <li><span>Date posted: <%= message.date%></span></li>
    </ul>  
    <button><a href="/message/<%= message.id %>" style="color: inherit; text-decoration: none;">Open</a></button>
  <% }%>
