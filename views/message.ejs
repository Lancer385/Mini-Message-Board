<!DOCTYPE html>
<head>
    <title><%= message.user %> message details</title>
</head>
<body>
    <h1><%= message.user %> message details</h1>
      <ul>
        <li><span>Username: <%= message.user%> </span></li>
        <li><span>Message: <%= message.text%></span></li>
        <li><span>Date posted: <%= message.date%></span></li>
    </ul>  
    <button><a href="/" style="color: inherit; text-decoration: none;">Go Back</a></button>
</body>
</html>