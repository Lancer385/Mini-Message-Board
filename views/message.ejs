<!DOCTYPE html>
<head>
    <title><%= message.username %> message details</title>
</head>
<body>
    <h1><%= message.username %> message details</h1>
      <ul>
        <li><span>Username: <%= message.username %> </span></li>
        <li><span>Message: <%= message.message %></span></li>
        <li><span>Date posted: <%= message.posted %></span></li>
    </ul>  
    <button><a href="/" style="color: inherit; text-decoration: none;">Go Back</a></button>
</body>
</html>